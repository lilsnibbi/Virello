{
	"name": "virello",
	"version": "0.1.1",
	"description": "A modular Discord framework for Bun, written in TypeScript.",
	"type": "module",
	"license": "MIT AND Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/lilsnibbi/virello.git"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts"
		},
		"./client": {
			"types": "./src/public/client.ts",
			"bun": "./src/public/client.ts"
		},
		"./modules": {
			"types": "./src/public/modules.ts",
			"bun": "./src/public/modules.ts"
		},
		"./commands": {
			"types": "./src/public/commands.ts",
			"bun": "./src/public/commands.ts"
		},
		"./events": {
			"types": "./src/public/events.ts",
			"bun": "./src/public/events.ts"
		},
		"./extensions": {
			"types": "./src/public/extensions.ts",
			"bun": "./src/public/extensions.ts"
		},
		"./localisation": {
			"types": "./src/public/localisation.ts",
			"bun": "./src/public/localisation.ts"
		},
		"./scheduling": {
			"types": "./src/public/scheduling.ts",
			"bun": "./src/public/scheduling.ts"
		},
		"./services": {
			"types": "./src/public/services.ts",
			"bun": "./src/public/services.ts"
		},
		"./sharding": {
			"types": "./src/public/sharding.ts",
			"bun": "./src/public/sharding.ts"
		},
		"./discord": {
			"types": "./src/public/discord.ts",
			"bun": "./src/public/discord.ts"
		},
		"./utilities": {
			"types": "./src/public/utilities.ts",
			"bun": "./src/public/utilities.ts"
		},
		"./time": {
			"types": "./src/public/time.ts",
			"bun": "./src/public/time.ts"
		},
		"./validation": {
			"types": "./src/public/validation.ts",
			"bun": "./src/public/validation.ts"
		},
		"./engine": {
			"types": "./src/public/engine.ts",
			"bun": "./src/public/engine.ts"
		}
	},
	"types": "./src/index.ts",
	"files": [
		"src",
		"docs",
		"examples",
		"README.md",
		"BREAKING_CHANGES.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@canary",
	"scripts": {
		"test": "bun test",
		"typecheck": "bun check",
		"lint:check": "bun lint && bun fmt --check",
		"format": "bun fmt",
		"engine:test": "bun test tests/engine"
	},
	"dependencies": {
		"@discordjs/builders": "^1.13.0",
		"@discordjs/collection": "^2.1.1",
		"@lilsnibbi/logger": "1.2.0",
		"arktype": "^2.2.8",
		"cron-parser": "5.10.2",
		"discord-api-types": "0.38.56",
		"discord.js": "^14.27.0",
		"i18next": "^26.4.5"
	},
	"devDependencies": {
		"@types/bun": "1.4.3",
		"@types/lodash": "4.17.26",
		"@types/ws": "8.18.2",
		"expect-type": "1.4.0",
		"lodash": "4.18.1",
		"typescript": "7.0.2"
	}
}
