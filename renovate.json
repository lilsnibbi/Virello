{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices"],
	"rangeStrategy": "bump",
	"timezone": "Australia/Sydney",
	"enabledManagers": ["bun", "bun-version", "github-actions", "custom.regex"],
	"reviewers": ["lilsnibbi"],
	"labels": ["dependencies", "renovate"],
	"prCreation": "immediate",
	"automerge": false,
	"prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}",
	"lockFileMaintenance": { "enabled": true },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [".github/workflows/ci.yml"],
			"matchStrings": [
				"image:\\s*(?<depName>redis):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+-bookworm)@(?<currentDigest>sha256:[a-f0-9]+)"
			],
			"datasourceTemplate": "docker",
			"versioningTemplate": "docker"
		}
	],
	"vulnerabilityAlerts": {
		"assignees": ["lilsnibbi"],
		"labels": ["dependencies", "renovate", "security"]
	},
	"packageRules": [
		{
			"description": "Group development tooling updates",
			"matchDepTypes": ["devDependencies"],
			"groupName": "Development tooling"
		},
		{
			"description": "Group non-major GitHub Actions updates",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "GitHub Actions"
		},
		{
			"description": "Group non-major container image updates",
			"matchDatasources": ["docker"],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "Container images"
		},
		{
			"description": "Highlight major updates for manual review",
			"matchUpdateTypes": ["major"],
			"addLabels": ["major-update"]
		}
	]
}
