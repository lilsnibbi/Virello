{
	"name": "virello",
	"version": "0.3.1",
	"description": "Modular Discord framework for Bun.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/lilsnibbi/Virello.git"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"bun": "./index.ts"
		}
	},
	"types": "./index.ts",
	"files": [
		"index.ts",
		"README.md"
	],
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"typecheck": "bun check",
		"lint:check": "bun lint && bun fmt --check",
		"format": "bun fmt",
		"release:check": "bun scripts/release.ts check",
		"release:sync": "bun scripts/release.ts sync",
		"release:pack": "bun scripts/release.ts pack",
		"release:verify": "bun scripts/release.ts verify",
		"release:publish": "bun scripts/publish.ts"
	},
	"dependencies": {
		"@virello/builders": "workspace:*",
		"@virello/core": "workspace:*",
		"@virello/engine": "workspace:*",
		"@virello/sharding": "workspace:*",
		"@virello/util": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	},
	"workspaces": [
		"packages/*"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
